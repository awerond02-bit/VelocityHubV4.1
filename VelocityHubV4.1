AutoWalkBox.FocusLost:Connect(function()
    local Value = tonumber(AutoWalkBox.Text)
    if Value then
        AutoWalkSpeed = math.clamp(Value, 20, 3000)
        AutoWalkBox.Text = tostring(AutoWalkSpeed)
    else
        AutoWalkBox.Text = tostring(AutoWalkSpeed)
    end
end)

SetAutoWalkPoint.MouseButton1Click:Connect(function()
    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    if Root then
        AutoWalkCheckpoint = Root.Position
        SetAutoWalkPoint.Text = "Point Saved!"
        task.delay(1, function()
            SetAutoWalkPoint.Text = "Set Target Point"
        end)
    end
end)

local ActiveTween = nil

StartAutoWalk.MouseButton1Click:Connect(function()
    if IsAutoWalking then
        IsAutoWalking = false
        if ActiveTween then
            ActiveTween:Cancel()
            ActiveTween = nil
        end
        StartAutoWalk.Text = "Start Ultra Speed"
        return
    end

    if not AutoWalkCheckpoint then
        StartAutoWalk.Text = "Set Point First!"
        task.delay(1, function()
            StartAutoWalk.Text = "Start Ultra Speed"
        end)
        return
    end

    local Character = Player.Character
    local Root = Character and Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")

    if not Root or not Humanoid or Humanoid.Health <= 0 then
        return
    end

    IsAutoWalking = true
    StartAutoWalk.Text = "Stop Walk"

    -- Включаем постоянный NoClip во время движения Tween
    task.spawn(function()
        while IsAutoWalking do
            local Char = Player.Character
            if Char then
                for _, part in ipairs(Char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            RunService.Stepped:Wait()
        end
    end)

    task.spawn(function()
        local CurrentPos = Root.Position
        local TargetPos = Vector3.new(AutoWalkCheckpoint.X, CurrentPos.Y, AutoWalkCheckpoint.Z)
        local Distance = (TargetPos - CurrentPos).Magnitude

        -- Рассчитываем точное время полета на основе заданной скорости
        local TimeToReach = Distance / math.max(AutoWalkSpeed, 10)

        -- Направляем персонажа лицом к цели
        Root.CFrame = CFrame.new(CurrentPos, TargetPos)

        local TweenInfoConfig = TweenInfo.new(
            TimeToReach,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.Out
        )

        ActiveTween = TweenService:Create(Root, TweenInfoConfig, {
            CFrame = CFrame.new(TargetPos, TargetPos + Root.CFrame.LookVector)
        })

        ActiveTween:Play()

        ActiveTween.Completed:Connect(function(status)
            if status == Enum.PlaybackState.Completed then
                IsAutoWalking = false
                StartAutoWalk.Text = "Reached Target!"
                task.delay(1.5, function()
                    StartAutoWalk.Text = "Start Ultra Speed"
                end)
            end
        end)
    end)
end)

